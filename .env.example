# Скопируйте в .env и заполните своими значениями.
# Сам .env в git не коммитится.

# PostgreSQL
DB_NAME=training_territory
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Gmail: пароль приложения, не основной пароль аккаунта
EMAIL_USER=
EMAIL_PASS=
# Куда слать отзывы (по умолчанию — на EMAIL_USER)
FEEDBACK_TO=

# Адрес фронтенда для CORS
FRONTEND_URL=http://localhost:3000

# FastAPI-сервис с ML
ML_URL=http://127.0.0.1:8001

# Ключ подписи сессионной cookie. Обязателен в проде.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# clientid пользователя с правами администратора
ADMIN_CLIENT_ID=1
